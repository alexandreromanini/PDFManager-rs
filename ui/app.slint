// Fenêtre de PDFManager (phase 1 : lecteur). Même organisation que la version Python :
// barre d'application (accueil, onglets, recherche, thème, menu), accueil, barre du
// document, vue des pages, rail de droite (vignettes, signets), notifications.
import { LineEdit, ComboBox, ListView, ScrollView, Button, Palette, CheckBox, SpinBox, TextEdit } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
export { Theme }

export struct TabData { name: string, path: string }
export struct RecentData { name: string, folder: string, when: string, path: string }
export struct Area { x: length, y: length, w: length, h: length }
export struct PageData {
    index: int, x: length, y: length, w: length, h: length, image: image,
    hits: [Area], current: [Area], selection: [Area], draft: [Area], marked: [Area], path: string, fields: [Area],
}
export struct PropRow { label: string, value: string }
export struct ChatMessage { user: bool, text: string, pages: [int] }
export struct SigData { level: string, summary: string, details: string, can-trust: bool, can-view: bool }
export struct DiffData { kind: string, text: string, page: string }
export struct CommentData { page: int, label: string, author: string, date: string, content: string, selected: bool }
export struct ThumbData { index: int, image: image, w: length, h: length, selected: bool, drop-before: bool }
export struct BookmarkData { title: string, level: int, page: int }

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> checked: false;
    in property <length> icon-size: 18px;
    in property <string> label;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: !enabled ? transparent : checked ? Theme.accent-soft
        : ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-checkable: checked;
    accessible-checked: checked;
    accessible-action-default => { if enabled { root.clicked(); } }
    Image {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        colorize: !root.enabled ? Theme.text3 : root.checked ? Theme.accent : Theme.icon;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();
    height: 36px;
    border-radius: 6px;
    opacity: enabled ? 1 : 0.45;
    background: enabled && ta.has-hover ? Theme.accent-hover : Theme.accent;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.clicked(); } }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        alignment: center;
        Image { source: root.icon; colorize: Theme.accent-text; width: 16px; y: (parent.height - self.height) / 2; }
        Text { text: root.text; color: Theme.accent-text; font-weight: 600; vertical-alignment: center; }
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Ligne d'action du panneau d'outils : icône + libellé (abrégé s'il est trop long).
component ToolRow inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> tile: false;
    in property <bool> enabled: true;
    callback clicked();
    height: tile ? 40px : 36px;
    border-radius: 6px;
    background: ta.has-hover && enabled ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.clicked(); } }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        Rectangle {
            width: root.tile ? 28px : 20px;
            height: self.width;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: root.tile ? Theme.accent-soft : transparent;
            Image { source: root.icon; width: 17px; colorize: !root.enabled ? Theme.text3 : root.tile ? Theme.accent : Theme.icon; }
        }
        Text { text: root.text; color: root.enabled ? Theme.text : Theme.text3; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Section inherits Text {
    color: Theme.text2;
    font-size: 12px;
    font-weight: 600;
}

component DocTab inherits Rectangle {
    in property <string> name;
    in property <string> tip;
    in property <bool> selected;
    callback activate();
    callback close();
    height: 36px;
    min-width: 120px;
    max-width: 260px;
    border-radius: 8px;
    border-width: 1px;
    border-color: selected ? Theme.control-border : transparent;
    background: selected ? Theme.layer : ta.has-hover ? Theme.hover : transparent;
    accessible-role: tab;
    accessible-label: tip;
    accessible-checked: selected;
    accessible-action-default => { root.activate(); }
    ta := TouchArea { clicked => { root.activate(); } }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 8px;
        Image { source: Icons.file; colorize: Theme.accent; width: 16px; y: (parent.height - self.height) / 2; }
        Text {
            text: root.name;
            color: root.selected ? Theme.text : Theme.text2;
            font-weight: root.selected ? 600 : 400;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        IconButton { icon: Icons.close; icon-size: 14px; width: 24px; height: 24px; y: 6px; label: "Fermer"; clicked => { root.close(); } }
    }
}

component Tile inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> checked;
    callback clicked();
    width: 60px;
    height: 60px;
    border-radius: 6px;
    background: root.checked ? Theme.accent-soft : ta.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Image { source: root.icon; width: 20px; height: 20px; colorize: root.checked ? Theme.accent-on-soft : Theme.icon; }
        }
        Text {
            text: root.text;
            font-size: 11px;
            horizontal-alignment: center;
            wrap: word-wrap;
            color: root.checked ? Theme.accent-on-soft : Theme.text;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Swatches inherits HorizontalLayout {
    in property <[color]> colors;
    in property <[string]> names;
    in property <int> current;
    callback picked(int);
    spacing: 8px;
    alignment: start;
    for c[i] in root.colors: Rectangle {
        width: 26px;
        height: 26px;
        border-radius: 13px;
        background: c;
        border-width: i == root.current ? 3px : 1px;
        border-color: i == root.current ? Theme.accent : Theme.border-strong;
        accessible-role: button;
        accessible-label: root.names[i];
        accessible-checkable: true;
        accessible-checked: i == root.current;
        accessible-action-default => { root.picked(i); }
        TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
    }
}

component Separator inherits Rectangle {
    width: 1px;
    height: 22px;
    background: Theme.border;
}

export component AppWindow inherits Window {
    in property <string> doc-title;
    title: root.doc-title == "" ? "PDFManager" : root.doc-title + " - PDFManager";
    icon: Icons.logo;
    preferred-width: 1280px;
    preferred-height: 850px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.window;
    default-font-family: "Segoe UI Variable Text";

    in property <bool> dark;
    in property <[TabData]> tabs;
    in property <int> current-tab: -1;
    in property <bool> on-home: true;
    in property <[RecentData]> recent;
    in property <[PageData]> pages;
    in property <length> content-width;
    in property <length> content-height;
    in-out property <length> scroll-y;
    in property <string> page-text: "1";
    in property <int> page-count;
    in property <string> zoom-text: "100 %";
    in property <int> mode-index;
    in property <[ThumbData]> thumbs;
    in property <[BookmarkData]> bookmarks;
    in property <int> current-page;
    in property <string> search-info;
    in property <bool> sidebar-visible: true;
    in property <int> rail-tab;
    in property <string> toast-text;
    in property <bool> toast-visible;
    in property <string> password-file;
    in property <string> password-prompt;
    in property <string> version;
    in property <bool> modified;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <int> panel;            // 0 : catalogue, 1 : organiser les pages
    in property <bool> crop-mode;
    in property <string> selection-info;
    in property <[string]> merge-names;
    in-out property <int> merge-index: -1;
    callback action(string);
    callback set-panel(int);
    callback thumb-press(int, bool, bool);
    callback thumb-drag(int, length, length);
    callback thumb-release();
    callback merge-command(string);
    callback split-run(bool, int, string);
    public function show-merge() { merge-popup.show(); }
    public function show-split() { split-popup.show(); }
    public function show-note() { note-popup.show(); }
    public function show-header() { header-popup.show(); }
    public function show-watermark() { watermark-popup.show(); }
    public function show-choices() { choice-popup.show(); }
    public function show-protect() { protect-popup.show(); }
    public function show-owner() { owner-popup.show(); }
    public function show-props() { props-popup.show(); }
    public function show-clean() { clean-popup.show(); }
    public function show-ocr() { ocr-popup.show(); }
    public function show-compress() { compress-popup.show(); }
    public function show-images() { images-popup.show(); }
    public function show-sig-create() { sig-create-popup.show(); }
    public function show-digital() { digital-popup.show(); }
    function show-signatures() {
        if (!root.sidebar-visible) { root.toggle-sidebar(); }
        root.set-rail-tab(5);
        root.action("verify");
    }
    in property <[image]> saved-sigs;
    in property <string> sig-path;
    in property <image> sig-preview;
    in property <[string]> sig-choices;
    in-out property <string> pfx-path;
    in-out property <string> tsa-url;
    in property <[SigData]> sigs;
    in property <string> sig-status;
    in property <[DiffData]> diffs;
    callback sig-draw(float, float, bool);
    callback sig-clear();
    callback sig-typed(string);
    callback sig-import();
    callback sig-save(int, float, float);
    callback sig-place(int);
    callback sig-delete(int);
    callback pick-pfx();
    callback digital-run(string, string, string, string, bool, string, int);
    callback sig-trust(int);
    callback sig-signed-version(int);
    callback diff-clicked(int);
    in property <bool> ai-installed;
    in property <bool> ai-busy;
    in property <string> ai-progress;
    in property <[ChatMessage]> chat;
    callback export-images-run(bool, int, string);
    callback compress-run(int);
    callback ocr-run(int, string, bool);
    callback ai-ask(string);
    callback chat-page(int);
    callback clean-run(bool, bool, bool, bool);
    in property <bool> editor-single;
    in property <[string]> choices;
    in property <string> choice-title;
    in property <[PropRow]> prop-rows;
    in property <string> prop-info;
    callback choice-picked(int);
    callback protect-run(string, string, string, string, bool, bool, bool, bool);
    callback owner-entered(string);
    callback prop-edited(int, string);
    callback props-save();
    function show-assistant() {
        if (!root.sidebar-visible) { root.toggle-sidebar(); }
        root.set-rail-tab(3);
    }
    function show-comments() {
        if (!root.sidebar-visible) { root.toggle-sidebar(); }
        root.set-rail-tab(2);
    }
    in property <string> tool;
    in property <bool> drawing;
    in-out property <int> color-index: 0;
    in-out property <int> text-color-index: 0;
    in-out property <int> stroke-width: 2;
    in-out property <int> text-size: 12;
    in-out property <int> stamp-index: 0;
    in property <string> author;
    in property <string> picked-info;
    in property <[CommentData]> comments;
    in property <bool> editor-visible;
    in property <length> editor-x;
    in property <length> editor-y;
    in property <length> editor-w;
    in property <length> editor-h;
    in property <length> editor-font;
    in property <color> editor-color;
    in-out property <string> editor-text;
    in property <string> note-title;
    in-out property <string> note-text;
    callback set-tool(string);
    callback pick-color(bool, int);
    callback text-size-changed(int);
    callback set-author(string);
    callback page-double(int, length, length);
    callback note-done(string);
    callback comment-clicked(int);
    callback comment-edit(int);
    callback comment-delete(int);
    callback header-run(string, string, string, string, string, string, int, int, string);
    callback watermark-run(string, int, int, int, string);

    callback open();
    callback open-recent(string);
    callback select-tab(int);
    callback close-tab(int);
    callback go-home();
    callback toggle-theme();
    callback set-theme(string);
    callback search(string);
    callback search-step(int);
    callback page-entered(string);
    callback step-page(int);
    callback zoom-step(int);
    callback zoom-entered(string);
    callback fit(int);
    callback rotate(int);
    callback mode-selected(int);
    callback scrolled(length, length);
    callback viewport-resized(length, length);
    callback wheel-zoom(length);
    callback page-press(int, length, length);
    callback page-drag(int, length, length);
    callback page-release(int, length, length);
    callback copy();
    callback thumb-clicked(int);
    callback bookmark-clicked(int);
    callback set-rail-tab(int);
    callback toggle-sidebar();
    callback toggle-fullscreen();
    callback quit();
    callback password-entered(string);
    callback password-cancelled();

    // Thème : nos couleurs, et celles des champs standard de Slint (palette).
    init => {
        Theme.dark = root.dark;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Theme.dark = root.dark;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }

    public function ask-password() {
        password-popup.show();  // contenu recréé à chaque ouverture : champ vide
    }
    public function focus-search() { search-field.focus(); search-field.select-all(); }

    keys := FocusScope {
        key-pressed(e) => {
            if (e.modifiers.control) {
                if (e.text == "o" || e.text == "O") { root.open(); return accept; }
                if (e.text == "w" || e.text == "W") { root.close-tab(root.current-tab); return accept; }
                if (e.text == "f" || e.text == "F") { root.focus-search(); return accept; }
                if (e.text == "c" || e.text == "C") { root.copy(); return accept; }
                if (e.text == "p" || e.text == "P") { root.action("print"); return accept; }
                if (e.text == "d" || e.text == "D") { root.action("properties"); return accept; }
                if (e.text == "z" || e.text == "Z") { root.action("undo"); return accept; }
                if (e.text == "y" || e.text == "Y") { root.action("redo"); return accept; }
                if (e.text == "s" || e.text == "S") { root.action(e.modifiers.shift ? "save-as" : "save"); return accept; }
                if (e.text == "+" || e.text == "=") { root.zoom-step(1); return accept; }
                if (e.text == "-") { root.zoom-step(-1); return accept; }
                if (e.text == "0") { root.fit(2); return accept; }
                if (e.text == "2") { root.fit(1); return accept; }
                if (e.text == Key.Tab) { root.select-tab(Math.mod(root.current-tab + 1, max(1, root.tabs.length))); return accept; }
                return reject;
            }
            if (e.text == Key.Delete) { root.action("delete"); return accept; }
            if (e.text == Key.Escape) { root.action("escape"); return accept; }
            if (e.text == Key.F3) { root.search-step(e.modifiers.shift ? -1 : 1); return accept; }
            if (e.text == Key.F4) { root.toggle-sidebar(); return accept; }
            if (e.text == Key.F11) { root.toggle-fullscreen(); return accept; }
            if (e.text == Key.PageDown) { root.step-page(1); return accept; }
            if (e.text == Key.PageUp) { root.step-page(-1); return accept; }
            if (e.text == Key.Home) { root.page-entered("1"); return accept; }
            if (e.text == Key.End) { root.page-entered(root.page-count); return accept; }
            return reject;
        }

        VerticalLayout {
            // ----- barre d'application -----------------------------------------------------
            Rectangle {
                height: 52px;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 12px;
                    spacing: 6px;
                    Image { source: Icons.logo; width: 24px; y: (parent.height - self.height) / 2; }
                    Rectangle { width: 4px; }
                    home := Rectangle {
                        width: home-row.preferred-width + 24px;
                        height: 36px;
                        y: 8px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.on-home ? Theme.control-border : transparent;
                        background: root.on-home ? Theme.layer : home-ta.has-hover ? Theme.hover : transparent;
                        accessible-role: button;
                        accessible-label: "Accueil";
                        home-row := HorizontalLayout {
                            x: 12px;
                            spacing: 6px;
                            Image { source: Icons.house; colorize: Theme.accent; width: 16px; y: (parent.height - self.height) / 2; }
                            Text { text: "Accueil"; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                        }
                        home-ta := TouchArea { mouse-cursor: pointer; clicked => { root.go-home(); } }
                    }
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        alignment: start;
                        for t[i] in root.tabs: DocTab {
                            name: t.name;
                            tip: t.path;
                            selected: !root.on-home && i == root.current-tab;
                            activate => { root.select-tab(i); }
                            close => { root.close-tab(i); }
                        }
                    }
                    IconButton { icon: Icons.plus; y: 10px; label: "Ouvrir un PDF (Ctrl+O)"; clicked => { root.open(); } }
                    search-field := LineEdit {
                        width: 300px;
                        height: 34px;
                        y: 9px;
                        placeholder-text: "Rechercher dans le document (Ctrl+F)";
                        enabled: root.tabs.length > 0;
                        accepted(text) => { root.search(text); }
                    }
                    Text { text: root.search-info; color: Theme.text2; vertical-alignment: center; min-width: 0px; }
                    IconButton { icon: Icons.chevron-up; y: 10px; enabled: root.search-info != ""; label: "Résultat précédent (Maj+F3)"; clicked => { root.search-step(-1); } }
                    IconButton { icon: Icons.chevron-down; y: 10px; enabled: root.search-info != ""; label: "Résultat suivant (F3)"; clicked => { root.search-step(1); } }
                    IconButton { icon: Theme.dark ? Icons.sun : Icons.moon; y: 10px; label: Theme.dark ? "Thème clair" : "Thème sombre"; clicked => { root.toggle-theme(); } }
                    IconButton { icon: Icons.ellipsis; y: 10px; label: "Menu"; clicked => { menu.show(); } }
                }
            }

            // ----- panneau d'outils + contenu -------------------------------------------------
            HorizontalLayout {
            vertical-stretch: 1;
            Rectangle {
                width: 272px;
                if root.panel == 0: Flickable {
                    content-height: cat.preferred-height;
                    cat := VerticalLayout {
                    padding: 12px;
                    padding-top: 6px;
                    spacing: 2px;
                    alignment: start;
                    Section { text: "Organiser"; height: 28px; vertical-alignment: center; }
                    ToolRow { tile: true; icon: Icons.organize; text: "Organiser les pages"; enabled: root.tabs.length > 0; clicked => { root.set-panel(1); } }
                    ToolRow { tile: true; icon: Icons.combine; text: "Fusionner des PDF"; clicked => { root.action("merge"); } }
                    ToolRow { tile: true; icon: Icons.scissors; text: "Scinder un PDF"; enabled: root.tabs.length > 0; clicked => { root.action("split"); } }
                    Section { text: "Modifier"; height: 28px; vertical-alignment: center; }
                    ToolRow { tile: true; icon: Icons.edit; text: "Ajouter du texte et des images"; enabled: root.tabs.length > 0; clicked => { root.set-panel(3); } }
                    ToolRow { tile: true; icon: Icons.note; text: "Commenter"; enabled: root.tabs.length > 0; clicked => { root.set-panel(2); } }
                    ToolRow { tile: true; icon: Icons.field; text: "Formulaires"; enabled: root.tabs.length > 0; clicked => { root.set-panel(4); } }
                    Section { text: "Convertir et optimiser"; height: 28px; vertical-alignment: center; }
                    ToolRow { tile: true; icon: Icons.ocr; text: "Reconnaître le texte (OCR)"; enabled: root.tabs.length > 0; clicked => { root.action("ocr"); } }
                    ToolRow { tile: true; icon: Icons.shrink; text: "Réduire la taille"; enabled: root.tabs.length > 0; clicked => { root.action("compress"); } }
                    ToolRow { tile: true; icon: Icons.convert; text: "Convertir (Word, images, texte)"; clicked => { root.set-panel(5); } }
                    ToolRow { tile: true; icon: Icons.compare; text: "Comparer deux PDF"; enabled: root.tabs.length > 0; clicked => { root.action("compare"); } }
                    ToolRow { tile: true; icon: Icons.archive; text: "Archiver (PDF/A)"; enabled: root.tabs.length > 0; clicked => { root.action("pdfa"); } }
                    Section { text: "Signer et protéger"; height: 28px; vertical-alignment: center; }
                    ToolRow { tile: true; icon: Icons.signature; text: "Signer"; enabled: root.tabs.length > 0; clicked => { root.set-panel(6); } }
                    ToolRow { tile: true; icon: Icons.lock; text: "Protéger par mot de passe"; enabled: root.tabs.length > 0; clicked => { root.action("protect"); } }
                    ToolRow { tile: true; icon: Icons.unlock; text: "Retirer la protection"; enabled: root.tabs.length > 0; clicked => { root.action("unprotect"); } }
                    Section { text: "Assistant IA"; height: 28px; vertical-alignment: center; }
                    ToolRow { tile: true; icon: Icons.bot; text: "Résumer, poser des questions"; clicked => { root.show-assistant(); } }
                    Rectangle { height: 12px; }
                    Rectangle { height: 4px; }
                    }
                }
                if root.panel == 1: Flickable {
                    content-height: org.preferred-height;
                    org := VerticalLayout {
                        padding: 12px;
                        padding-top: 6px;
                        spacing: 2px;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 8px;
                            IconButton { icon: Icons.back; label: "Tous les outils"; clicked => { root.set-panel(0); } }
                            Text { text: "Organiser les pages"; font-size: 16px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                        }
                        Text { text: root.selection-info; color: Theme.text2; wrap: word-wrap; height: 36px; vertical-alignment: center; }
                        ToolRow { icon: Icons.rotate-left; text: "Pivoter à gauche"; clicked => { root.action("rotate-left"); } }
                        ToolRow { icon: Icons.rotate-right; text: "Pivoter à droite"; clicked => { root.action("rotate-right"); } }
                        ToolRow { icon: Icons.trash; text: "Supprimer"; clicked => { root.action("delete"); } }
                        ToolRow { icon: Icons.file-down; text: "Extraire…"; clicked => { root.action("extract"); } }
                        ToolRow { icon: Icons.file-plus; text: "Insérer une page vierge"; clicked => { root.action("insert-blank"); } }
                        ToolRow { icon: Icons.file-input; text: "Insérer un PDF…"; clicked => { root.action("insert-pdf"); } }
                        ToolRow { icon: Icons.image-plus; text: "Insérer des images…"; clicked => { root.action("insert-images"); } }
                        ToolRow { icon: Icons.crop; text: "Recadrer (tracer la zone à garder)"; clicked => { root.action("crop"); } }
                        ToolRow { icon: Icons.fit-page; text: "Annuler le recadrage"; clicked => { root.action("reset-crop"); } }
                        ToolRow { icon: Icons.combine; text: "Fusionner des PDF…"; clicked => { root.action("merge"); } }
                        ToolRow { icon: Icons.scissors; text: "Scinder le document…"; clicked => { root.action("split"); } }
                        ToolRow { icon: Icons.panel; text: "En-tête, pied de page et numérotation…"; clicked => { root.action("header"); } }
                        ToolRow { icon: Icons.droplets; text: "Filigrane…"; clicked => { root.action("watermark"); } }
                        Text {
                            text: "Les actions portent sur les vignettes sélectionnées (Ctrl+clic, Maj+clic), sinon sur la page affichée. Glissez une vignette pour déplacer des pages.";
                            color: Theme.text2;
                            wrap: word-wrap;
                            font-size: 12px;
                        }
                    }
                }
                if root.panel == 2: Flickable {
                    content-height: com.preferred-height;
                    com := VerticalLayout {
                        padding: 12px;
                        padding-top: 6px;
                        spacing: 6px;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 8px;
                            IconButton { icon: Icons.back; label: "Tous les outils"; clicked => { root.set-tool(""); root.set-panel(0); } }
                            Text { text: "Commenter"; font-size: 16px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                        }
                        Rectangle {
                            height: 3 * 62px;
                            for t[i] in [
                                { id: "", text: "Sélection", icon: Icons.pointer },
                                { id: "highlight", text: "Surligner", icon: Icons.highlighter },
                                { id: "underline", text: "Souligner", icon: Icons.underline },
                                { id: "strikeout", text: "Barrer", icon: Icons.strikethrough },
                                { id: "note", text: "Note", icon: Icons.note },
                                { id: "freetext", text: "Texte libre", icon: Icons.text },
                                { id: "rect", text: "Rectangle", icon: Icons.square },
                                { id: "ellipse", text: "Ellipse", icon: Icons.circle },
                                { id: "line", text: "Ligne", icon: Icons.line },
                                { id: "arrow", text: "Flèche", icon: Icons.arrow },
                                { id: "ink", text: "Dessin", icon: Icons.pencil },
                                { id: "stamp", text: "Tampon", icon: Icons.stamp },
                            ]: Tile {
                                x: Math.mod(i, 4) * 62px;
                                y: Math.floor(i / 4) * 62px;
                                icon: t.icon;
                                text: t.text;
                                checked: root.tool == t.id;
                                clicked => { root.set-tool(t.id); }
                            }
                        }
                        if root.tool == "stamp": ComboBox {
                            model: ["Approuvé", "Non approuvé", "Brouillon", "Final", "Confidentiel", "Pour commentaire", "Expiré", "Top secret"];
                            current-index <=> root.stamp-index;
                        }
                        Section { text: "Couleur"; height: 28px; vertical-alignment: center; }
                        Swatches {
                            colors: [#FFD60A, #7BD389, #64B5F6, #F48FB1, #E53935, #1B1B1B];
                            names: ["Jaune", "Vert", "Bleu", "Rose", "Rouge", "Noir"];
                            current: root.color-index;
                            picked(i) => { root.pick-color(false, i); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Épaisseur des traits"; color: Theme.text; vertical-alignment: center; }
                            SpinBox { minimum: 1; maximum: 20; value <=> root.stroke-width; width: 90px; }
                        }
                        Section { text: "Commentaires"; height: 28px; vertical-alignment: center; }
                        ToolRow { icon: Icons.list; text: "Voir la liste des commentaires"; clicked => { root.show-comments(); } }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Auteur"; color: Theme.text; vertical-alignment: center; }
                            LineEdit { text: root.author; placeholder-text: "nom de session"; edited(t) => { root.set-author(t); } }
                        }
                        if root.picked-info != "": Text { text: root.picked-info; color: Theme.text2; wrap: word-wrap; font-size: 12px; }
                        Text {
                            text: "Sélection : cliquez un commentaire pour le sélectionner, glissez-le pour le déplacer, double-cliquez pour modifier son texte, Suppr pour le supprimer. Échap revient à la sélection.";
                            color: Theme.text2;
                            wrap: word-wrap;
                            font-size: 12px;
                        }
                    }
                }
                if root.panel == 3: Flickable {
                    content-height: edt.preferred-height;
                    edt := VerticalLayout {
                        padding: 12px;
                        padding-top: 6px;
                        spacing: 6px;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 8px;
                            IconButton { icon: Icons.back; label: "Tous les outils"; clicked => { root.set-tool(""); root.set-panel(0); } }
                            Text { text: "Modifier"; font-size: 16px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                        }
                        Rectangle {
                            height: 62px;
                            Tile { x: 0px; icon: Icons.pointer; text: "Sélection"; checked: root.tool == ""; clicked => { root.set-tool(""); } }
                            Tile { x: 62px; icon: Icons.edit; text: "Modifier le texte"; checked: root.tool == "edit-text"; clicked => { root.set-tool("edit-text"); } }
                            Tile { x: 124px; icon: Icons.type; text: "Ajouter du texte"; checked: root.tool == "text"; clicked => { root.set-tool("text"); } }
                            Tile { x: 186px; icon: Icons.image; text: "Image"; checked: root.tool == "image"; clicked => { root.action("add-image"); } }
                        }
                        Section { text: "Texte ajouté"; height: 28px; vertical-alignment: center; }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Taille"; color: Theme.text; vertical-alignment: center; }
                            SpinBox { minimum: 4; maximum: 200; value <=> root.text-size; width: 90px; edited(v) => { root.text-size-changed(v); } }
                        }
                        Swatches {
                            colors: [#000000, #E53935, #1E88E5, #43A047, #FB8C00, #8E24AA];
                            names: ["Noir", "Rouge", "Bleu", "Vert", "Orange", "Violet"];
                            current: root.text-color-index;
                            picked(i) => { root.pick-color(true, i); }
                        }
                        Section { text: "Pages"; height: 28px; vertical-alignment: center; }
                        ToolRow { icon: Icons.panel; text: "En-tête, pied de page et numérotation…"; clicked => { root.action("header"); } }
                        ToolRow { icon: Icons.droplets; text: "Filigrane…"; clicked => { root.action("watermark"); } }
                        Section { text: "Caviardage"; height: 28px; vertical-alignment: center; }
                        Rectangle {
                            height: 62px;
                            Tile { x: 0px; icon: Icons.redact; text: "Caviarder une zone"; checked: root.tool == "redact"; clicked => { root.set-tool("redact"); } }
                        }
                        ToolRow { icon: Icons.search; text: "Caviarder un texte (partout)…"; clicked => { root.action("redact-text"); } }
                        ToolRow { icon: Icons.redact; text: "Appliquer les caviardages…"; clicked => { root.action("redact-apply"); } }
                        ToolRow { icon: Icons.eraser; text: "Nettoyer le document…"; clicked => { root.action("clean"); } }
                        Text {
                            text: "Modifier le texte : cliquez un paragraphe et corrigez-le sur la page, puis cliquez à côté (Échap pour annuler). Seules les lignes changées sont réécrites, dans la police d'origine ou la même police installée sur l'ordinateur ; sinon une police proche, et vous êtes prévenu.";
                            color: Theme.text2;
                            wrap: word-wrap;
                            font-size: 12px;
                        }
                        Text {
                            text: "Ajouter du texte : cliquez ou tracez une bulle et écrivez dedans ; cliquez à côté pour valider (Échap pour annuler). Ensuite, glissez-la pour la déplacer et double-cliquez pour la modifier. Taille et couleur s'appliquent au texte sélectionné et aux suivants.";
                            color: Theme.text2;
                            wrap: word-wrap;
                            font-size: 12px;
                        }
                        Text {
                            text: "Caviardage : les zones marquées restent réversibles ; « Appliquer » supprime vraiment ce qu'elles couvrent.";
                            color: Theme.text2;
                            wrap: word-wrap;
                            font-size: 12px;
                        }
                    }
                }
                if root.panel == 4: Flickable {
                    content-height: frm.preferred-height;
                    frm := VerticalLayout {
                        padding: 12px;
                        padding-top: 6px;
                        spacing: 6px;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 8px;
                            IconButton { icon: Icons.back; label: "Tous les outils"; clicked => { root.set-tool(""); root.set-panel(0); } }
                            Text { text: "Formulaires"; font-size: 16px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                        }
                        Rectangle {
                            height: 2 * 62px;
                            for t[i] in [
                                { id: "", text: "Remplir", icon: Icons.pointer },
                                { id: "field-text", text: "Champ texte", icon: Icons.field },
                                { id: "field-check", text: "Case à cocher", icon: Icons.check },
                                { id: "field-combo", text: "Liste déroulante", icon: Icons.combo },
                                { id: "field-signature", text: "Champ de signature", icon: Icons.signature },
                            ]: Tile {
                                x: Math.mod(i, 4) * 62px;
                                y: Math.floor(i / 4) * 62px;
                                icon: t.icon;
                                text: t.text;
                                checked: root.tool == t.id;
                                clicked => { root.set-tool(t.id); }
                            }
                        }
                        Text {
                            text: "Remplir : cliquez dans un champ (surligné en bleu) et écrivez directement ; Entrée valide. Un clic sur une case la coche ou la décoche.";
                            color: Theme.text2;
                            wrap: word-wrap;
                            font-size: 12px;
                        }
                        Text {
                            text: "Créer : choisissez un type de champ, puis tracez son cadre sur la page (ou cliquez). Un clic sur un champ existant propose de le supprimer.";
                            color: Theme.text2;
                            wrap: word-wrap;
                            font-size: 12px;
                        }
                    }
                }
                if root.panel == 5: Flickable {
                    content-height: cnv.preferred-height;
                    cnv := VerticalLayout {
                        padding: 12px;
                        padding-top: 6px;
                        spacing: 2px;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 8px;
                            IconButton { icon: Icons.back; label: "Tous les outils"; clicked => { root.set-panel(0); } }
                            Text { text: "Convertir"; font-size: 16px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                        }
                        Section { text: "Depuis ce PDF"; height: 28px; vertical-alignment: center; }
                        ToolRow { icon: Icons.file; text: "Exporter en Word (.docx)…"; enabled: root.tabs.length > 0; clicked => { root.action("export-word"); } }
                        ToolRow { icon: Icons.file-image; text: "Exporter en images…"; enabled: root.tabs.length > 0; clicked => { root.action("export-images"); } }
                        ToolRow { icon: Icons.file; text: "Exporter en texte (.txt)…"; enabled: root.tabs.length > 0; clicked => { root.action("export-text"); } }
                        Section { text: "Créer un PDF"; height: 28px; vertical-alignment: center; }
                        ToolRow { icon: Icons.image-plus; text: "Depuis des images…"; clicked => { root.action("from-images"); } }
                        ToolRow { icon: Icons.file-input; text: "Depuis des documents Office…"; clicked => { root.action("from-office"); } }
                        Text {
                            text: "Word : paragraphes et images sont reconstruits ; la mise en page peut différer pour les documents complexes. Office : LibreOffice (gratuit) doit être installé.";
                            color: Theme.text2;
                            wrap: word-wrap;
                            font-size: 12px;
                        }
                    }
                }
                if root.panel == 6: Flickable {
                    content-height: sgn.preferred-height;
                    sgn := VerticalLayout {
                        padding: 12px;
                        padding-top: 6px;
                        spacing: 4px;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 8px;
                            IconButton { icon: Icons.back; label: "Tous les outils"; clicked => { root.set-tool(""); root.set-panel(0); } }
                            Text { text: "Signer"; font-size: 16px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                        }
                        Section { text: "Signature manuscrite"; height: 28px; vertical-alignment: center; }
                        ToolRow { icon: Icons.pen; text: "Créer une signature…"; clicked => { root.action("sign-create"); } }
                        for img[i] in root.saved-sigs: Rectangle {
                            height: 64px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: sta.has-hover ? Theme.hover : Theme.layer;
                            sta := TouchArea { mouse-cursor: pointer; clicked => { root.sig-place(i); } }
                            Image { x: 8px; y: 6px; width: parent.width - 52px; height: parent.height - 12px; source: img; image-fit: contain; }
                            IconButton { x: parent.width - 38px; y: 14px; icon: Icons.trash; label: "Supprimer"; clicked => { root.sig-delete(i); } }
                        }
                        if root.saved-sigs.length > 0: Text { text: "Cliquez une signature, puis tracez son emplacement sur la page (ou cliquez)."; color: Theme.text2; wrap: word-wrap; font-size: 12px; }
                        Section { text: "Signature numérique"; height: 28px; vertical-alignment: center; }
                        Rectangle {
                            height: 62px;
                            Tile { x: 0px; icon: Icons.signature; text: "Signer avec un certificat"; checked: root.tool == "digital-sign"; clicked => { root.set-tool("digital-sign"); } }
                        }
                        ToolRow { icon: Icons.badge; text: "Vérifier les signatures"; enabled: root.tabs.length > 0; clicked => { root.show-signatures(); } }
                        Text {
                            text: "Signature numérique : certificat .pfx / .p12, au format PAdES reconnu par Acrobat, horodatage possible. Elle s'ajoute au fichier sans toucher aux signatures précédentes. Un document signé reste modifiable (commentaires, formulaire) : les signatures restent valides et indiquent que le document a été complété.";
                            color: Theme.text2;
                            wrap: word-wrap;
                            font-size: 12px;
                        }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.layer;
                border-top-left-radius: 8px;
                if root.on-home || root.tabs.length == 0: home-page := Flickable {
                    content-height: home-content.preferred-height;
                    home-content := VerticalLayout {
                        padding: 40px;
                        padding-top: 32px;
                        spacing: 14px;
                        alignment: start;
                        Rectangle {
                            height: 130px;
                            border-radius: 12px;
                            border-width: 2px;
                            border-color: Theme.border-strong;
                            background: Theme.layer-alt;
                            HorizontalLayout {
                                padding: 32px;
                                spacing: 24px;
                                Rectangle {
                                    width: 64px;
                                    height: 64px;
                                    border-radius: 12px;
                                    background: Theme.accent-soft;
                                    Image { source: Icons.file-up; colorize: Theme.accent; width: 32px; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text { text: "Ouvrir un PDF"; font-size: 21px; font-weight: 600; color: Theme.text; }
                                    Text { text: "Glissez-déposez un ou plusieurs fichiers ici, ou choisissez-les sur votre ordinateur."; color: Theme.text2; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    PrimaryButton { text: "Choisir des fichiers"; icon: Icons.folder-open; clicked => { root.open(); } }
                                }
                            }
                        }
                        Rectangle { height: 10px; }
                        Text { text: "Récents"; font-size: 16px; font-weight: 600; color: Theme.text; }
                        if root.recent.length == 0: Text { text: "Aucun fichier récent."; color: Theme.text2; }
                        for r in root.recent: Rectangle {
                            height: 52px;
                            border-radius: 8px;
                            background: rta.has-hover ? Theme.hover : transparent;
                            accessible-role: button;
                            accessible-label: r.path;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 14px;
                                Rectangle {
                                    width: 34px;
                                    height: 34px;
                                    y: 9px;
                                    border-radius: 8px;
                                    background: Theme.accent-soft;
                                    Image { source: Icons.file; colorize: Theme.accent; width: 18px; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text { text: r.name; font-weight: 600; color: Theme.text; overflow: elide; }
                                    Text { text: r.folder; color: Theme.text2; overflow: elide; }
                                }
                                Text { text: r.when; color: Theme.text2; vertical-alignment: center; }
                            }
                            rta := TouchArea { mouse-cursor: pointer; clicked => { root.open-recent(r.path); } }
                        }
                    }
                }
                if !root.on-home && root.tabs.length > 0: VerticalLayout {
                    // barre du document
                    Rectangle {
                        height: 46px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 2px;
                            IconButton { icon: Icons.undo; y: 7px; enabled: root.can-undo; label: "Annuler (Ctrl+Z)"; clicked => { root.action("undo"); } }
                            IconButton { icon: Icons.redo; y: 7px; enabled: root.can-redo; label: "Rétablir (Ctrl+Y)"; clicked => { root.action("redo"); } }
                            Rectangle { width: 12px; Separator { } }
                            IconButton { icon: Icons.chevron-left; y: 7px; label: "Page précédente"; clicked => { root.step-page(-1); } }
                            LineEdit {
                                width: 56px;
                                height: 32px;
                                y: 7px;
                                horizontal-alignment: center;
                                text: root.page-text;
                                accepted(text) => { root.page-entered(text); }
                            }
                            Text { text: " / " + root.page-count; color: Theme.text2; vertical-alignment: center; }
                            IconButton { icon: Icons.chevron-right; y: 7px; label: "Page suivante"; clicked => { root.step-page(1); } }
                            Rectangle { width: 12px; Separator { } }
                            IconButton { icon: Icons.zoom-out; y: 7px; label: "Zoom arrière (Ctrl+-)"; clicked => { root.zoom-step(-1); } }
                            LineEdit {
                                width: 80px;
                                height: 32px;
                                y: 7px;
                                horizontal-alignment: center;
                                text: root.zoom-text;
                                accepted(text) => { root.zoom-entered(text); }
                            }
                            IconButton { icon: Icons.zoom-in; y: 7px; label: "Zoom avant (Ctrl++)"; clicked => { root.zoom-step(1); } }
                            IconButton { icon: Icons.fit-width; y: 7px; label: "Ajuster à la largeur (Ctrl+2)"; clicked => { root.fit(1); } }
                            IconButton { icon: Icons.fit-page; y: 7px; label: "Ajuster à la page (Ctrl+0)"; clicked => { root.fit(2); } }
                            Rectangle { width: 12px; Separator { } }
                            IconButton { icon: Icons.rotate-left; y: 7px; label: "Pivoter l'affichage à gauche"; clicked => { root.rotate(-90); } }
                            IconButton { icon: Icons.rotate-right; y: 7px; label: "Pivoter l'affichage à droite"; clicked => { root.rotate(90); } }
                            Rectangle { width: 12px; Separator { } }
                            ComboBox {
                                width: 150px;
                                height: 32px;
                                y: 7px;
                                model: ["Continu", "Page unique", "Double page"];
                                current-index: root.mode-index;
                                selected => { root.mode-selected(self.current-index); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            PrimaryButton {
                                y: 5px;
                                text: "Enregistrer";
                                icon: Icons.save;
                                enabled: root.modified;
                                clicked => { root.action("save"); }
                            }
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 1;
                        // vue des pages
                        Rectangle {
                            horizontal-stretch: 1;
                            background: Theme.canvas;
                            init => { root.viewport-resized(self.width, self.height); }
                            changed width => { root.viewport-resized(self.width, self.height); }
                            changed height => { root.viewport-resized(self.width, self.height); }
                            view := ScrollView {
                                content-width: max(root.content-width, self.visible-width);
                                content-height: root.content-height;
                                content-y <=> root.scroll-y;
                                changed content-y => { root.scrolled(-self.content-y, self.visible-height); }
                                changed visible-height => { root.scrolled(-self.content-y, self.visible-height); }
                                wheel := TouchArea {
                                    width: view.content-width;
                                    height: view.content-height;
                                    scroll-event(e) => {
                                        if (e.modifiers.control) { root.wheel-zoom(e.delta-y); return accept; }
                                        return reject;
                                    }
                                }
                                for p in root.pages: Rectangle {
                                    x: p.x + max(0px, (view.visible-width - root.content-width) / 2);
                                    y: p.y;
                                    width: p.w;
                                    height: p.h;
                                    background: white;
                                    drop-shadow-blur: 4px;
                                    drop-shadow-color: #00000030;
                                    Image { source: p.image; width: parent.width; height: parent.height; image-fit: fill; }
                                    for b in p.hits: Rectangle { x: b.x; y: b.y; width: b.w; height: b.h; background: Theme.hit; }
                                    for b in p.current: Rectangle { x: b.x; y: b.y; width: b.w; height: b.h; background: Theme.current-hit; }
                                    for b in p.selection: Rectangle { x: b.x; y: b.y; width: b.w; height: b.h; background: Theme.selection; }
                                    for b in p.draft: Rectangle { x: b.x; y: b.y; width: b.w; height: b.h; border-width: 2px; border-color: Theme.accent; background: #D93A2B1f; }
                                    for b in p.fields: Rectangle { x: b.x; y: b.y; width: b.w; height: b.h; background: #2563eb1c; border-width: 1px; border-color: #2563eb66; }
                                    for b in p.marked: Rectangle { x: b.x - 2px; y: b.y - 2px; width: b.w + 4px; height: b.h + 4px; border-width: 2px; border-color: Theme.accent; }
                                    if p.path != "": Path {
                                        width: parent.width;
                                        height: parent.height;
                                        viewbox-width: self.width / 1px;
                                        viewbox-height: self.height / 1px;
                                        commands: p.path;
                                        stroke: Theme.accent;
                                        stroke-width: 2px;
                                    }
                                    pta := TouchArea {
                                        mouse-cursor: root.crop-mode || root.drawing ? MouseCursor.crosshair : MouseCursor.text;
                                        double-clicked => { root.page-double(p.index, self.mouse-x, self.mouse-y); }
                                        pointer-event(e) => {
                                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                                keys.focus();
                                                root.page-press(p.index, self.mouse-x, self.mouse-y);
                                            }
                                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                                                root.page-release(p.index, self.mouse-x, self.mouse-y);
                                            }
                                        }
                                        moved => { if (self.pressed) { root.page-drag(p.index, self.mouse-x, self.mouse-y); } }
                                        scroll-event(e) => {
                                            if (e.modifiers.control) { root.wheel-zoom(e.delta-y); return accept; }
                                            return reject;
                                        }
                                    }
                                }
                                if root.editor-visible: Rectangle {
                                    x: root.editor-x + max(0px, (view.visible-width - root.content-width) / 2);
                                    y: root.editor-y;
                                    width: max(root.editor-w, editor-input.preferred-width + 10px);
                                    height: max(root.editor-h, editor-input.preferred-height + 6px);
                                    background: #ffffffe6;
                                    border-width: 1px;
                                    border-color: Theme.accent;
                                    editor-input := TextInput {
                                        x: 4px;
                                        y: 3px;
                                        width: parent.width - 8px;
                                        text <=> root.editor-text;
                                        font-size: root.editor-font;
                                        color: root.editor-color;
                                        single-line: root.editor-single;
                                        init => { self.focus(); }
                                        accepted => { root.action("editor-commit"); }
                                    }
                                }
                            }
                        }
                        // rail de droite
                        if root.sidebar-visible: Rectangle {
                            width: 260px;
                            border-width: 0px;
                            HorizontalLayout {
                                Rectangle { width: 1px; background: Theme.border; }
                                if root.rail-tab == 0: ListView {
                                    horizontal-stretch: 1;
                                    for t in root.thumbs: Rectangle {
                                        height: t.h + 30px;
                                        background: t.selected ? Theme.accent-soft : transparent;
                                        if t.drop-before: Rectangle { y: 0px; height: 3px; background: Theme.accent; }
                                        VerticalLayout {
                                            padding-top: 6px;
                                            spacing: 4px;
                                            alignment: start;
                                            Rectangle {
                                                width: t.w + 6px;
                                                height: t.h + 6px;
                                                x: (parent.width - self.width) / 2;
                                                border-radius: 4px;
                                                border-width: 2px;
                                                border-color: t.selected ? Theme.accent : t.index == root.current-page ? Theme.border-strong : transparent;
                                                Rectangle {
                                                    width: t.w;
                                                    height: t.h;
                                                    background: white;
                                                    border-width: 1px;
                                                    border-color: #00000030;
                                                    // en retrait d'1 px : sans quoi l'image couvre le contour (page
                                                    // blanche invisible sur le fond clair)
                                                    Image { source: t.image; x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px; }
                                                }
                                            }
                                            Text { text: t.index + 1; horizontal-alignment: center; color: Theme.text2; }
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            pointer-event(e) => {
                                                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                                    keys.focus();
                                                    root.thumb-press(t.index, e.modifiers.control, e.modifiers.shift);
                                                }
                                                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) { root.thumb-release(); }
                                            }
                                            moved => { if (self.pressed) { root.thumb-drag(t.index, self.mouse-y, self.height); } }
                                        }
                                    }
                                }
                                if root.rail-tab == 1 && root.bookmarks.length == 0: Text {
                                    horizontal-stretch: 1;
                                    text: "Aucun signet";
                                    color: Theme.text2;
                                    vertical-alignment: top;
                                    horizontal-alignment: center;
                                }
                                if root.rail-tab == 1 && root.bookmarks.length > 0: ListView {
                                    horizontal-stretch: 1;
                                    for b in root.bookmarks: Rectangle {
                                        height: 30px;
                                        background: bta.has-hover ? Theme.hover : transparent;
                                        Text {
                                            x: 12px + b.level * 16px;
                                            width: parent.width - self.x - 8px;
                                            text: b.title;
                                            color: b.page < 0 ? Theme.text2 : Theme.text;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                        bta := TouchArea { mouse-cursor: pointer; clicked => { root.bookmark-clicked(b.page); } }
                                    }
                                }
                                if root.rail-tab == 2 && root.comments.length == 0: Text {
                                    horizontal-stretch: 1;
                                    text: "Aucun commentaire";
                                    color: Theme.text2;
                                    vertical-alignment: top;
                                    horizontal-alignment: center;
                                }
                                if root.rail-tab == 2 && root.comments.length > 0: ListView {
                                    horizontal-stretch: 1;
                                    for c[i] in root.comments: Rectangle {
                                        height: 66px;
                                        background: c.selected ? Theme.accent-soft : cta.has-hover ? Theme.hover : transparent;
                                        cta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.comment-clicked(i); }
                                            double-clicked => { root.comment-edit(i); }
                                        }
                                        VerticalLayout {
                                            padding: 8px;
                                            padding-right: 40px;
                                            spacing: 2px;
                                            Text { text: c.label + " - page " + c.page; font-weight: 600; color: Theme.text; overflow: elide; }
                                            Text { text: c.author + (c.date != "" ? ", " + c.date : ""); font-size: 11px; color: Theme.text2; overflow: elide; }
                                            Text { text: c.content; font-size: 12px; color: Theme.text2; overflow: elide; }
                                        }
                                        IconButton { x: parent.width - 38px; y: 6px; icon: Icons.trash; label: "Supprimer"; clicked => { root.comment-delete(i); } }
                                    }
                                }
                                if root.rail-tab == 3: VerticalLayout {
                                    horizontal-stretch: 1;
                                    padding: 10px;
                                    spacing: 8px;
                                    if !root.ai-installed: VerticalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        Text {
                                            text: "L'assistant résume le document et répond à vos questions. Il fonctionne hors ligne, sur cet ordinateur : le document n'est envoyé nulle part.\n\nIl faut d'abord télécharger son modèle (2,5 Go, une seule fois). Prévoir 8 Go de mémoire vive.";
                                            color: Theme.text2;
                                            wrap: word-wrap;
                                        }
                                        PrimaryButton { text: "Télécharger l'assistant"; icon: Icons.bot; enabled: root.ai-progress == ""; clicked => { root.action("ai-download"); } }
                                        Text { text: root.ai-progress; color: Theme.text2; }
                                    }
                                    if root.ai-installed && root.chat.length == 0: Text {
                                        vertical-stretch: 1;
                                        text: "Résumez le document ou posez une question : la réponse s'appuie uniquement sur son contenu, pages à l'appui.";
                                        color: Theme.text2;
                                        wrap: word-wrap;
                                    }
                                    if root.ai-installed && root.chat.length > 0: ListView {
                                        vertical-stretch: 1;
                                        for m in root.chat: Rectangle {
                                            height: msg.preferred-height + 12px;
                                            msg := VerticalLayout {
                                                y: 6px;
                                                padding: 8px;
                                                spacing: 4px;
                                                Rectangle {
                                                    background: m.user ? Theme.accent-soft : Theme.layer-alt;
                                                    border-radius: 6px;
                                                    height: body.preferred-height + 12px;
                                                    body := Text { x: 8px; y: 6px; width: parent.width - 16px; text: m.text; color: Theme.text; wrap: word-wrap; }
                                                }
                                                if m.pages.length > 0: HorizontalLayout {
                                                    spacing: 4px;
                                                    alignment: start;
                                                    for p in m.pages: Rectangle {
                                                        width: plink.preferred-width + 12px;
                                                        height: 22px;
                                                        border-radius: 4px;
                                                        background: pta2.has-hover ? Theme.hover : transparent;
                                                        plink := Text { text: "p. " + p; color: Theme.accent; vertical-alignment: center; horizontal-alignment: center; }
                                                        pta2 := TouchArea { mouse-cursor: pointer; clicked => { root.chat-page(p); } }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if root.ai-installed: HorizontalLayout {
                                        spacing: 6px;
                                        Button { text: "Résumer le document"; enabled: !root.ai-busy && root.tabs.length > 0; clicked => { root.ai-ask(""); } }
                                        if root.ai-busy: Button { text: "Arrêter"; clicked => { root.action("ai-stop"); } }
                                    }
                                    if root.ai-installed: HorizontalLayout {
                                        spacing: 6px;
                                        question := LineEdit {
                                            placeholder-text: "Poser une question…";
                                            enabled: !root.ai-busy && root.tabs.length > 0;
                                            accepted(t) => { root.ai-ask(t); self.text = ""; }
                                        }
                                        IconButton {
                                            icon: Icons.send;
                                            label: "Envoyer";
                                            enabled: !root.ai-busy && question.text != "";
                                            clicked => { root.ai-ask(question.text); question.text = ""; }
                                        }
                                    }
                                }
                                if root.rail-tab == 4 && root.diffs.length == 0: Text {
                                    horizontal-stretch: 1;
                                    text: "Aucune comparaison : « Comparer deux PDF » dans les outils.";
                                    color: Theme.text2;
                                    wrap: word-wrap;
                                    vertical-alignment: top;
                                    horizontal-alignment: center;
                                }
                                if root.rail-tab == 4 && root.diffs.length > 0: ListView {
                                    horizontal-stretch: 1;
                                    for d[i] in root.diffs: Rectangle {
                                        height: dcol.preferred-height + 8px;
                                        background: dta.has-hover ? Theme.hover : transparent;
                                        dta := TouchArea { mouse-cursor: pointer; clicked => { root.diff-clicked(i); } }
                                        dcol := VerticalLayout {
                                            y: 4px;
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 2px;
                                            Text { text: d.kind; font-weight: 600; color: d.kind == "Ajouté" ? #2e7d32 : d.kind == "Supprimé" ? #c62828 : Theme.accent; }
                                            Text { text: d.text; color: Theme.text; wrap: word-wrap; }
                                            Text { text: d.page; font-size: 11px; color: Theme.text2; }
                                        }
                                    }
                                }
                                if root.rail-tab == 5: VerticalLayout {
                                    horizontal-stretch: 1;
                                    padding: 10px;
                                    spacing: 8px;
                                    if root.sig-status != "": Text { text: root.sig-status; color: Theme.text2; wrap: word-wrap; }
                                    ListView {
                                        vertical-stretch: 1;
                                        for s[i] in root.sigs: Rectangle {
                                            height: scol.preferred-height + 12px;
                                            scol := VerticalLayout {
                                                y: 6px;
                                                spacing: 4px;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Image {
                                                        width: 18px;
                                                        source: s.level == "ok" ? Icons.ok : s.level == "warning" ? Icons.warning : Icons.bad;
                                                        colorize: s.level == "ok" ? #2e7d32 : s.level == "warning" ? #e68a00 : #c62828;
                                                    }
                                                    Text { text: s.summary; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                                                }
                                                Text { text: s.details; color: Theme.text2; wrap: word-wrap; font-size: 12px; }
                                                if s.can-trust: Button { text: "Faire confiance au certificat…"; clicked => { root.sig-trust(i); } }
                                                if s.can-view: Button { text: "Voir la version signée"; clicked => { root.sig-signed-version(i); } }
                                                Rectangle { height: 1px; background: Theme.border; }
                                            }
                                        }
                                    }
                                }
                                Rectangle { width: 1px; background: Theme.border; }
                                VerticalLayout {
                                    width: 48px;
                                    padding-top: 6px;
                                    spacing: 6px;
                                    alignment: start;
                                    IconButton { x: 8px; icon: Icons.pages; checked: root.rail-tab == 0; label: "Pages"; clicked => { root.set-rail-tab(0); } }
                                    IconButton { x: 8px; icon: Icons.bookmark; checked: root.rail-tab == 1; label: "Signets"; clicked => { root.set-rail-tab(1); } }
                                    IconButton { x: 8px; icon: Icons.list; checked: root.rail-tab == 2; label: "Commentaires"; clicked => { root.set-rail-tab(2); } }
                                    IconButton { x: 8px; icon: Icons.bot; checked: root.rail-tab == 3; label: "Assistant IA"; clicked => { root.set-rail-tab(3); } }
                                    IconButton { x: 8px; icon: Icons.compare; checked: root.rail-tab == 4; label: "Différences"; clicked => { root.set-rail-tab(4); } }
                                    IconButton { x: 8px; icon: Icons.signature; checked: root.rail-tab == 5; label: "Signatures"; clicked => { root.show-signatures(); } }
                                }
                            }
                        }
                    }
                }

                // notification
                if root.toast-visible: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 24px;
                    width: min(560px, toast-label.preferred-width + 36px);
                    height: toast-label.preferred-height + 20px;
                    border-radius: 8px;
                    background: Theme.toast;
                    toast-label := Text {
                        width: parent.width - 36px;
                        text: root.toast-text;
                        color: Theme.toast-text;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }
            }
            }
        }
    }

    // ----- menu ⋯ -----------------------------------------------------------------------------
    menu := PopupWindow {
        x: root.width - 260px;
        y: 48px;
        width: 248px;
        Rectangle {
            background: Theme.layer;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: 4px;
                for item[i] in [
                    { label: "Ouvrir…  (Ctrl+O)", action: "open" },
                    { label: "Enregistrer  (Ctrl+S)", action: "save" },
                    { label: "Enregistrer sous…  (Ctrl+Maj+S)", action: "save-as" },
                    { label: "Enregistrer une copie…", action: "save-copy" },
                    { label: "Imprimer…  (Ctrl+P)", action: "print" },
                    { label: "Propriétés du document…  (Ctrl+D)", action: "properties" },
                    { label: "Annuler  (Ctrl+Z)", action: "undo" },
                    { label: "Rétablir  (Ctrl+Y)", action: "redo" },
                    { label: "Fermer l'onglet  (Ctrl+W)", action: "close" },
                    { label: "Accueil et fichiers récents", action: "home" },
                    { label: "Panneau latéral  (F4)", action: "sidebar" },
                    { label: "Plein écran  (F11)", action: "fullscreen" },
                    { label: "Thème : système", action: "theme-system" },
                    { label: "Thème : clair", action: "theme-light" },
                    { label: "Thème : sombre", action: "theme-dark" },
                    { label: "Rechercher des mises à jour…", action: "check-updates" },
                    { label: "À propos", action: "about" },
                    { label: "Quitter", action: "quit" },
                ]: Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: mta.has-hover ? Theme.hover : transparent;
                    Text { x: 10px; text: item.label; color: Theme.text; vertical-alignment: center; }
                    mta := TouchArea {
                        clicked => {
                            if (item.action == "open") { root.open(); }
                            if (item.action == "save" || item.action == "save-as" || item.action == "save-copy"
                                || item.action == "undo" || item.action == "redo" || item.action == "print"
                                || item.action == "properties" || item.action == "check-updates") { root.action(item.action); }
                            if (item.action == "close") { root.close-tab(root.current-tab); }
                            if (item.action == "home") { root.go-home(); }
                            if (item.action == "sidebar") { root.toggle-sidebar(); }
                            if (item.action == "fullscreen") { root.toggle-fullscreen(); }
                            if (item.action == "theme-system") { root.set-theme("system"); }
                            if (item.action == "theme-light") { root.set-theme("light"); }
                            if (item.action == "theme-dark") { root.set-theme("dark"); }
                            if (item.action == "about") { about.show(); }
                            if (item.action == "quit") { root.quit(); }
                        }
                    }
                }
            }
        }
    }

    about := PopupWindow {
        x: (root.width - 360px) / 2;
        y: (root.height - 170px) / 2;
        width: 360px;
        Rectangle {
            background: Theme.layer;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text { text: "PDFManager " + root.version; font-size: 16px; font-weight: 600; color: Theme.text; }
                Text { text: "Réécriture en Rust. MuPDF (AGPL), interface Slint, icônes Lucide (ISC). Usage personnel."; color: Theme.text2; wrap: word-wrap; }
            }
        }
    }

    password-popup := PopupWindow {
        x: (root.width - 380px) / 2;
        y: (root.height - 190px) / 2;
        width: 380px;
        close-policy: no-auto-close;
        Rectangle {
            background: Theme.layer;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: "Mot de passe"; font-size: 16px; font-weight: 600; color: Theme.text; }
                Text { text: root.password-prompt; color: Theme.text2; wrap: word-wrap; }
                password-field := LineEdit {
                    input-type: password;
                    init => { self.focus(); }
                    accepted(text) => { password-popup.close(); root.password-entered(text); }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Annuler"; clicked => { password-popup.close(); root.password-cancelled(); } }
                    Button { text: "Ouvrir"; primary: true; clicked => { password-popup.close(); root.password-entered(password-field.text); } }
                }
            }
        }
    }

    merge-popup := PopupWindow {
        x: (root.width - 480px) / 2;
        y: (root.height - 400px) / 2;
        width: 480px;
        close-policy: no-auto-close;
        Rectangle {
            background: Theme.layer;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "Fusionner des PDF"; font-size: 16px; font-weight: 600; color: Theme.text; }
                Text { text: "Ordre de fusion : sélectionnez un fichier pour le déplacer ou le retirer."; color: Theme.text2; wrap: word-wrap; }
                Rectangle {
                    height: 200px;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 6px;
                    ListView {
                        for name[i] in root.merge-names: Rectangle {
                            height: 30px;
                            background: i == root.merge-index ? Theme.accent-soft : transparent;
                            Text { x: 10px; width: parent.width - 20px; text: name; color: Theme.text; overflow: elide; vertical-alignment: center; }
                            TouchArea { clicked => { root.merge-index = i; } }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Button { text: "Ajouter…"; clicked => { root.merge-command("add"); } }
                    Button { text: "Retirer"; enabled: root.merge-index >= 0; clicked => { root.merge-command("remove"); } }
                    Button { text: "Monter"; enabled: root.merge-index > 0; clicked => { root.merge-command("up"); } }
                    Button { text: "Descendre"; enabled: root.merge-index >= 0 && root.merge-index < root.merge-names.length - 1; clicked => { root.merge-command("down"); } }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Annuler"; clicked => { merge-popup.close(); } }
                    Button { text: "Fusionner…"; primary: true; enabled: root.merge-names.length >= 2; clicked => { merge-popup.close(); root.merge-command("run"); } }
                }
            }
        }
    }

    split-popup := PopupWindow {
        x: (root.width - 440px) / 2;
        y: (root.height - 280px) / 2;
        width: 440px;
        close-policy: no-auto-close;
        Rectangle {
            background: Theme.layer;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "Scinder le document"; font-size: 16px; font-weight: 600; color: Theme.text; }
                ranges := LineEdit { placeholder-text: "Plages, une par fichier : 1-3, 4-10, 11-"; enabled: !every.checked; }
                HorizontalLayout {
                    spacing: 8px;
                    every := CheckBox { text: "Ou bien toutes les"; }
                    count := SpinBox { minimum: 1; maximum: 9999; value: 1; width: 100px; enabled: every.checked; }
                    Text { text: "pages"; color: Theme.text; vertical-alignment: center; }
                }
                Text { text: "Le dossier de destination se choisit à l'étape suivante."; color: Theme.text2; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Annuler"; clicked => { split-popup.close(); } }
                    Button { text: "Scinder…"; primary: true; clicked => { split-popup.close(); root.split-run(every.checked, count.value, ranges.text); } }
                }
            }
        }
    }

    note-popup := PopupWindow {
        x: (root.width - 420px) / 2;
        y: (root.height - 260px) / 2;
        width: 420px;
        close-policy: no-auto-close;
        Rectangle {
            background: Theme.layer;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: root.note-title; font-size: 16px; font-weight: 600; color: Theme.text; }
                TextEdit { height: 120px; text <=> root.note-text; init => { self.focus(); } }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Annuler"; clicked => { note-popup.close(); } }
                    Button { text: "OK"; primary: true; clicked => { note-popup.close(); root.note-done(root.note-text); } }
                }
            }
        }
    }

    header-popup := PopupWindow {
        x: (root.width - 620px) / 2;
        y: (root.height - 340px) / 2;
        width: 620px;
        close-policy: no-auto-close;
        Rectangle {
            background: Theme.layer;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "En-tête, pied de page et numérotation"; font-size: 16px; font-weight: 600; color: Theme.text; }
                Text {
                    text: "Champs utilisables : {n} numéro de page, {total} nombre de pages, {date}, {fichier} (nom du document).";
                    color: Theme.text2;
                    wrap: word-wrap;
                }
                GridLayout {
                    spacing: 6px;
                    Row {
                        Text { }
                        Text { text: "Gauche"; color: Theme.text2; }
                        Text { text: "Centre"; color: Theme.text2; }
                        Text { text: "Droite"; color: Theme.text2; }
                    }
                    Row {
                        Text { text: "En-tête"; color: Theme.text; vertical-alignment: center; }
                        h-tl := LineEdit { }
                        h-tc := LineEdit { }
                        h-tr := LineEdit { }
                    }
                    Row {
                        Text { text: "Pied de page"; color: Theme.text; vertical-alignment: center; }
                        h-bl := LineEdit { }
                        h-bc := LineEdit { text: "Page {n} sur {total}"; }
                        h-br := LineEdit { }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Taille"; color: Theme.text; vertical-alignment: center; }
                    h-size := SpinBox { minimum: 6; maximum: 36; value: 10; width: 90px; }
                    Rectangle { width: 12px; }
                    Text { text: "Premier numéro"; color: Theme.text; vertical-alignment: center; }
                    h-start := SpinBox { minimum: 0; maximum: 9999; value: 1; width: 100px; }
                    Rectangle { width: 12px; }
                    Text { text: "Pages"; color: Theme.text; vertical-alignment: center; }
                    h-pages := LineEdit { placeholder-text: "toutes (ou 2-10)"; }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Annuler"; clicked => { header-popup.close(); } }
                    Button {
                        text: "Ajouter";
                        primary: true;
                        clicked => {
                            header-popup.close();
                            root.header-run(h-tl.text, h-tc.text, h-tr.text, h-bl.text, h-bc.text, h-br.text,
                                            h-size.value, h-start.value, h-pages.text);
                        }
                    }
                }
            }
        }
    }

    watermark-popup := PopupWindow {
        x: (root.width - 460px) / 2;
        y: (root.height - 300px) / 2;
        width: 460px;
        close-policy: no-auto-close;
        Rectangle {
            background: Theme.layer;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "Filigrane"; font-size: 16px; font-weight: 600; color: Theme.text; }
                w-text := LineEdit { text: "CONFIDENTIEL"; }
                GridLayout {
                    spacing: 8px;
                    Row {
                        Text { text: "Taille"; color: Theme.text; vertical-alignment: center; }
                        w-size := SpinBox { minimum: 8; maximum: 300; value: 72; }
                        Text { text: "Opacité (%)"; color: Theme.text; vertical-alignment: center; }
                        w-opacity := SpinBox { minimum: 5; maximum: 100; value: 30; }
                    }
                    Row {
                        Text { text: "Inclinaison (°)"; color: Theme.text; vertical-alignment: center; }
                        w-angle := SpinBox { minimum: -90; maximum: 90; value: 45; }
                        Text { text: "Pages"; color: Theme.text; vertical-alignment: center; }
                        w-pages := LineEdit { placeholder-text: "toutes"; }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Annuler"; clicked => { watermark-popup.close(); } }
                    Button {
                        text: "Ajouter";
                        primary: true;
                        clicked => {
                            watermark-popup.close();
                            root.watermark-run(w-text.text, w-size.value, w-opacity.value, w-angle.value, w-pages.text);
                        }
                    }
                }
            }
        }
    }

    choice-popup := PopupWindow {
        x: (root.width - 360px) / 2;
        y: (root.height - 340px) / 2;
        width: 360px;
        close-policy: no-auto-close;
        Rectangle {
            background: Theme.layer;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: root.choice-title; font-size: 16px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                Rectangle {
                    height: 200px;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 6px;
                    ListView {
                        for c[i] in root.choices: Rectangle {
                            height: 30px;
                            background: chta.has-hover ? Theme.hover : transparent;
                            Text { x: 10px; text: c; color: Theme.text; vertical-alignment: center; }
                            chta := TouchArea { mouse-cursor: pointer; clicked => { choice-popup.close(); root.choice-picked(i); } }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Button { text: "Annuler"; clicked => { choice-popup.close(); } }
                }
            }
        }
    }

    protect-popup := PopupWindow {
        x: (root.width - 460px) / 2;
        y: (root.height - 480px) / 2;
        width: 460px;
        close-policy: no-auto-close;
        Rectangle {
            background: Theme.layer;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text { text: "Protéger par mot de passe"; font-size: 16px; font-weight: 600; color: Theme.text; }
                Text { text: "Chiffrement AES-256. Laissez le mot de passe d'ouverture vide pour un document lisible par tous mais aux permissions limitées."; color: Theme.text2; wrap: word-wrap; }
                GridLayout {
                    spacing: 6px;
                    Row {
                        Text { text: "Mot de passe d'ouverture"; color: Theme.text; vertical-alignment: center; }
                        p-open := LineEdit { input-type: password; }
                    }
                    Row {
                        Text { text: "Confirmation"; color: Theme.text; vertical-alignment: center; }
                        p-open2 := LineEdit { input-type: password; }
                    }
                    Row {
                        Text { text: "Mot de passe des permissions"; color: Theme.text; vertical-alignment: center; }
                        p-owner := LineEdit { input-type: password; }
                    }
                    Row {
                        Text { text: "Confirmation"; color: Theme.text; vertical-alignment: center; }
                        p-owner2 := LineEdit { input-type: password; }
                    }
                }
                Text { text: "Autoriser, sans le mot de passe des permissions :"; color: Theme.text; }
                p-print := CheckBox { text: "Imprimer"; checked: true; }
                p-copy := CheckBox { text: "Copier le texte et les images"; checked: true; }
                p-annotate := CheckBox { text: "Commenter et remplir les formulaires"; checked: true; }
                p-modify := CheckBox { text: "Modifier et réorganiser les pages"; checked: true; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Annuler"; clicked => { protect-popup.close(); } }
                    Button {
                        text: "Protéger";
                        primary: true;
                        clicked => {
                            protect-popup.close();
                            root.protect-run(p-open.text, p-open2.text, p-owner.text, p-owner2.text,
                                             p-print.checked, p-copy.checked, p-annotate.checked, p-modify.checked);
                        }
                    }
                }
            }
        }
    }

    owner-popup := PopupWindow {
        x: (root.width - 400px) / 2;
        y: (root.height - 200px) / 2;
        width: 400px;
        close-policy: no-auto-close;
        Rectangle {
            background: Theme.layer;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "Retirer la protection"; font-size: 16px; font-weight: 600; color: Theme.text; }
                Text { text: "Saisissez le mot de passe des permissions du document."; color: Theme.text2; wrap: word-wrap; }
                owner-field := LineEdit {
                    input-type: password;
                    init => { self.focus(); }
                    accepted => { owner-popup.close(); root.owner-entered(self.text); }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Annuler"; clicked => { owner-popup.close(); } }
                    Button { text: "OK"; primary: true; clicked => { owner-popup.close(); root.owner-entered(owner-field.text); } }
                }
            }
        }
    }

    props-popup := PopupWindow {
        x: (root.width - 520px) / 2;
        y: (root.height - 520px) / 2;
        width: 520px;
        close-policy: no-auto-close;
        Rectangle {
            background: Theme.layer;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text { text: "Propriétés du document"; font-size: 16px; font-weight: 600; color: Theme.text; }
                Text { text: root.prop-info; color: Theme.text2; wrap: word-wrap; }
                for r[i] in root.prop-rows: HorizontalLayout {
                    spacing: 8px;
                    Text { text: r.label; width: 150px; color: Theme.text; vertical-alignment: center; }
                    LineEdit { text: r.value; edited(t) => { root.prop-edited(i, t); } }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Annuler"; clicked => { props-popup.close(); } }
                    Button { text: "Enregistrer"; primary: true; clicked => { props-popup.close(); root.props-save(); } }
                }
            }
        }
    }

    clean-popup := PopupWindow {
        x: (root.width - 440px) / 2;
        y: (root.height - 320px) / 2;
        width: 440px;
        close-policy: no-auto-close;
        Rectangle {
            background: Theme.layer;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text { text: "Nettoyer le document"; font-size: 16px; font-weight: 600; color: Theme.text; }
                Text { text: "Retire les informations cachées avant de diffuser le document."; color: Theme.text2; wrap: word-wrap; }
                c-meta := CheckBox { text: "Métadonnées (auteur, titre, logiciel…)"; checked: true; }
                c-js := CheckBox { text: "JavaScript et actions automatiques"; checked: true; }
                c-files := CheckBox { text: "Pièces jointes"; checked: true; }
                c-thumbs := CheckBox { text: "Vignettes intégrées"; checked: true; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Annuler"; clicked => { clean-popup.close(); } }
                    Button {
                        text: "Nettoyer";
                        primary: true;
                        clicked => { clean-popup.close(); root.clean-run(c-meta.checked, c-js.checked, c-files.checked, c-thumbs.checked); }
                    }
                }
            }
        }
    }

    ocr-popup := PopupWindow {
        x: (root.width - 440px) / 2;
        y: (root.height - 300px) / 2;
        width: 440px;
        close-policy: no-auto-close;
        Rectangle {
            background: Theme.layer;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "Reconnaître le texte (OCR)"; font-size: 16px; font-weight: 600; color: Theme.text; }
                Text { text: "Le texte des pages scannées devient cherchable, sélectionnable et copiable ; l'aspect des pages ne change pas."; color: Theme.text2; wrap: word-wrap; }
                GridLayout {
                    spacing: 8px;
                    Row {
                        Text { text: "Langue du document"; color: Theme.text; vertical-alignment: center; }
                        o-lang := ComboBox { model: ["Français et anglais", "Français", "Anglais"]; current-index: 0; }
                    }
                    Row {
                        Text { text: "Pages"; color: Theme.text; vertical-alignment: center; }
                        o-pages := LineEdit { placeholder-text: "toutes (ou 1-5)"; }
                    }
                }
                o-all := CheckBox { text: "Aussi les pages qui contiennent déjà du texte"; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Annuler"; clicked => { ocr-popup.close(); } }
                    Button { text: "Reconnaître"; primary: true; clicked => { ocr-popup.close(); root.ocr-run(o-lang.current-index, o-pages.text, o-all.checked); } }
                }
            }
        }
    }

    compress-popup := PopupWindow {
        x: (root.width - 420px) / 2;
        y: (root.height - 240px) / 2;
        width: 420px;
        close-policy: no-auto-close;
        Rectangle {
            background: Theme.layer;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "Réduire la taille"; font-size: 16px; font-weight: 600; color: Theme.text; }
                Text { text: "Crée une copie plus légère ; le document ouvert ne change pas."; color: Theme.text2; wrap: word-wrap; }
                c-level := ComboBox {
                    model: ["Sans perte (structure, flux compressés)", "Équilibré (photos à 150 dpi)", "Maximal (photos à 96 dpi)"];
                    current-index: 1;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Annuler"; clicked => { compress-popup.close(); } }
                    Button { text: "Réduire…"; primary: true; clicked => { compress-popup.close(); root.compress-run(c-level.current-index); } }
                }
            }
        }
    }

    images-popup := PopupWindow {
        x: (root.width - 420px) / 2;
        y: (root.height - 280px) / 2;
        width: 420px;
        close-policy: no-auto-close;
        Rectangle {
            background: Theme.layer;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "Exporter en images"; font-size: 16px; font-weight: 600; color: Theme.text; }
                GridLayout {
                    spacing: 8px;
                    Row {
                        Text { text: "Format"; color: Theme.text; vertical-alignment: center; }
                        i-format := ComboBox { model: ["PNG (sans perte)", "JPEG (plus léger)"]; current-index: 0; }
                    }
                    Row {
                        Text { text: "Résolution (dpi)"; color: Theme.text; vertical-alignment: center; }
                        i-dpi := SpinBox { minimum: 36; maximum: 600; value: 150; }
                    }
                    Row {
                        Text { text: "Pages"; color: Theme.text; vertical-alignment: center; }
                        i-pages := LineEdit { placeholder-text: "toutes (ou 1-3, 5)"; }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Annuler"; clicked => { images-popup.close(); } }
                    Button { text: "Exporter…"; primary: true; clicked => { images-popup.close(); root.export-images-run(i-format.current-index == 1, i-dpi.value, i-pages.text); } }
                }
            }
        }
    }

    sig-create-popup := PopupWindow {
        x: (root.width - 520px) / 2;
        y: (root.height - 380px) / 2;
        width: 520px;
        close-policy: no-auto-close;
        Rectangle {
            background: Theme.layer;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "Créer une signature"; font-size: 16px; font-weight: 600; color: Theme.text; }
                sig-mode := ComboBox { model: ["Dessiner à la souris", "Taper mon nom", "Importer une image (scan, photo)"]; current-index: 0; }
                pad := Rectangle {
                    height: 180px;
                    background: white;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    border-radius: 6px;
                    if sig-mode.current-index == 0: TouchArea {
                        mouse-cursor: crosshair;
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                root.sig-draw(self.mouse-x / 1px, self.mouse-y / 1px, true);
                            }
                        }
                        moved => { if (self.pressed) { root.sig-draw(self.mouse-x / 1px, self.mouse-y / 1px, false); } }
                    }
                    if sig-mode.current-index == 0 && root.sig-path != "": Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-width: self.width / 1px;
                        viewbox-height: self.height / 1px;
                        commands: root.sig-path;
                        stroke: #0d1a59;
                        stroke-width: 2.2px;
                    }
                    if sig-mode.current-index == 0 && root.sig-path == "": Text { text: "Signez ici"; color: #9a9a9a; horizontal-alignment: center; vertical-alignment: center; }
                    if sig-mode.current-index != 0: Image { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px; source: root.sig-preview; image-fit: contain; }
                }
                if sig-mode.current-index == 1: LineEdit { placeholder-text: "Votre nom"; edited(t) => { root.sig-typed(t); } }
                HorizontalLayout {
                    spacing: 8px;
                    if sig-mode.current-index == 0: Button { text: "Effacer"; clicked => { root.sig-clear(); } }
                    if sig-mode.current-index == 2: Button { text: "Choisir l'image…"; clicked => { root.sig-import(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Annuler"; clicked => { sig-create-popup.close(); } }
                    Button { text: "Enregistrer"; primary: true; clicked => { sig-create-popup.close(); root.sig-save(sig-mode.current-index, pad.width / 1px, pad.height / 1px); } }
                }
            }
        }
    }

    digital-popup := PopupWindow {
        x: (root.width - 520px) / 2;
        y: (root.height - 440px) / 2;
        width: 520px;
        close-policy: no-auto-close;
        Rectangle {
            background: Theme.layer;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text { text: "Signer avec un certificat"; font-size: 16px; font-weight: 600; color: Theme.text; }
                GridLayout {
                    spacing: 6px;
                    Row {
                        Text { text: "Certificat (.pfx, .p12)"; color: Theme.text; vertical-alignment: center; }
                        HorizontalLayout {
                            spacing: 6px;
                            LineEdit { text <=> root.pfx-path; }
                            Button { text: "…"; clicked => { root.pick-pfx(); } }
                        }
                    }
                    Row {
                        Text { text: "Mot de passe"; color: Theme.text; vertical-alignment: center; }
                        d-pw := LineEdit { input-type: password; }
                    }
                    Row {
                        Text { text: "Motif"; color: Theme.text; vertical-alignment: center; }
                        d-reason := LineEdit { placeholder-text: "facultatif (ex. J'approuve ce document)"; }
                    }
                    Row {
                        Text { text: "Lieu"; color: Theme.text; vertical-alignment: center; }
                        d-location := LineEdit { placeholder-text: "facultatif"; }
                    }
                    Row {
                        Text { text: "Image de signature"; color: Theme.text; vertical-alignment: center; }
                        d-image := ComboBox { model: root.sig-choices; current-index: root.sig-choices.length > 1 ? 1 : 0; }
                    }
                }
                d-tsa := CheckBox { text: "Horodater (serveur d'horodatage, connexion internet)"; checked: true; }
                if d-tsa.checked: LineEdit { text <=> root.tsa-url; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Annuler"; clicked => { digital-popup.close(); } }
                    Button {
                        text: "Signer…";
                        primary: true;
                        clicked => {
                            digital-popup.close();
                            root.digital-run(root.pfx-path, d-pw.text, d-reason.text, d-location.text, d-tsa.checked, root.tsa-url, d-image.current-index);
                        }
                    }
                }
            }
        }
    }
}
