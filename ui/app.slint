// Phase 0 (essai) : ouvrir un PDF et faire défiler ses pages rendues par MuPDF.
import { Button, ScrollView } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "PDFManager";
    preferred-width: 1100px;
    preferred-height: 800px;
    in property <[image]> pages;
    in property <string> status: "Ouvrez un PDF pour commencer.";
    callback open();
    callback zoom-in();
    callback zoom-out();

    VerticalLayout {
        HorizontalLayout {
            padding: 8px;
            spacing: 6px;
            Button { text: "Ouvrir…"; clicked => { root.open(); } }
            Button { text: "−"; clicked => { root.zoom-out(); } }
            Button { text: "+"; clicked => { root.zoom-in(); } }
            Text { text: root.status; vertical-alignment: center; }
        }
        Rectangle {
            background: #EBEBEE;
            ScrollView {
                VerticalLayout {
                    alignment: start;
                    padding: 12px;
                    spacing: 12px;
                    for page in root.pages: HorizontalLayout {
                        alignment: center;
                        Image { source: page; }
                    }
                }
            }
        }
    }
}
