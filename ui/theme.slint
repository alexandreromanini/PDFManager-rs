// Thème « Windows 11 épuré », accent rouge PDF : mêmes couleurs que la version Python
// (ui/theme.py), en clair et en sombre. Icônes Lucide 0.460.0 (licence ISC).

export global Theme {
    in-out property <bool> dark: false;
    out property <color> window: dark ? #202020 : #F3F3F3;
    out property <color> layer: dark ? #272727 : #FFFFFF;
    out property <color> layer-alt: dark ? #2B2B2B : #FAFAFA;
    out property <color> border: dark ? #333333 : #E5E5E5;
    out property <color> border-strong: dark ? #4A4A4A : #CFCFCF;
    out property <color> control: dark ? #2D2D2D : #FFFFFF;
    out property <color> control-border: dark ? #3D3D3D : #DEDEDE;
    out property <color> text: dark ? #F2F2F2 : #1B1B1B;
    out property <color> text2: dark ? #ABABAB : #5F5F5F;
    out property <color> text3: dark ? #6E6E6E : #9A9A9A;
    out property <color> hover: dark ? #ffffff10 : #0000000d;
    out property <color> pressed: dark ? #ffffff1a : #00000017;
    out property <color> accent: dark ? #FF6F61 : #D93A2B;
    out property <color> accent-hover: dark ? #FF8A7E : #C2301F;
    out property <color> accent-text: dark ? #1B1B1B : #FFFFFF;
    out property <color> accent-soft: dark ? #4A2D2A : #FBE7E5;
    out property <color> accent-on-soft: dark ? #FF8A7E : #B02A1C;
    out property <color> canvas: dark ? #1A1A1A : #EBEBEE;
    out property <color> icon: dark ? #D6D6D6 : #3A3A3A;
    out property <color> toast: dark ? #F2F2F2 : #2B2B2B;
    out property <color> toast-text: dark ? #1B1B1B : #FFFFFF;
    out property <color> hit: #ffd2006e;
    out property <color> current-hit: #ff780096;
    out property <color> selection: #0078d75a;
}

